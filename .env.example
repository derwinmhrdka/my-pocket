# VPS / Docker Compose (.env on server, do not commit)
# Copy: cp .env.example .env

PIN_FALLBACK=1234
JWT_SECRET=change-me-to-a-long-random-string
APP_HOST_PORT=13001
DOMAIN=my-pocket.teknodika.com
CLIENT_ORIGIN=https://my-pocket.teknodika.com
NODE_ENV=production

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://my-pocket.teknodika.com/auth/google/callback

# DATABASE_URL is set automatically in docker-compose (db service).
# No need to change unless DB architecture changes.

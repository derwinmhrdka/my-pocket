PORT=13001
# Local Windows Postgres (same credentials as DealHub)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/mypocket
# Docker alternative: postgresql://mypocket:mypocket@localhost:5433/mypocket
PIN_FALLBACK=1234
JWT_SECRET=change-me-in-production
NODE_ENV=development
# Vite app origin (also used for OAuth cookie + redirect)
CLIENT_ORIGIN=http://localhost:13002

# Google Cloud Console → OAuth client (Web)
# Authorized JavaScript origins:
#   http://localhost:13002
#   https://my-pocket.teknodika.com
# Authorized redirect URIs:
#   http://localhost:13002/auth/google/callback
#   https://my-pocket.teknodika.com/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override (defaults to ${CLIENT_ORIGIN}/auth/google/callback)
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:13002/auth/google/callback
